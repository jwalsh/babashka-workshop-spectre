# Environment for working through the workshop. `gmake .env` copies this to
# .env, which git ignores and direnv loads (see .envrc). Plain KEY=value
# lines: no `export`, no shell expansion, quotes around a value with spaces.

# The identity `bb pw`, `bb tui` and `bb tui2` start with, so you are not
# asked each run. This is the throwaway identity the tests use. Do NOT put a
# real master password in this file: it is plain text on disk.
SPECTRE_NAME="John Doe"
SPECTRE_MASTER=hunter2

# The next three are derived per checkout by .envrc, so a worktree gets its
# own without editing anything. Set one here only to override it.
#
# Site settings file. Derived: db.edn in this checkout (git-ignored). Without
# direnv it is ~/.config/spectre/db.edn, your real database.
#SPECTRE_DB=/absolute/path/to/db.edn
#
# Fixed nREPL port for `gmake nrepl` and `gmake e5-tui`. Derived: 1667 in the
# main checkout, a stable port in 1700-1999 in a worktree.
#NREPL_PORT=1667
#
# Where `bbin install .` puts the pw launcher in E6. Derived: .bin in this
# checkout, which .envrc also puts first on PATH.
#BABASHKA_BBIN_BIN_DIR=/absolute/path/to/bin

# An OpenSSL 3 binary, when the one spectre.scrypt finds is not the one you
# want. `gmake deps` shows which it picks.
#SPECTRE_OPENSSL=/opt/homebrew/opt/openssl@3/bin/openssl

# Set to run the E2 test that writes to your real clipboard. `gmake
# e2-clipboard` sets it for one run; leave it off here.
#SPECTRE_CLIPBOARD_TEST=1
