# direnv: load .env on entering the directory, and again when it changes.
# Run `direnv allow` once per checkout (each worktree is its own).
dotenv_if_exists .env

# Per-checkout values, derived from where this checkout is. .env cannot
# compute anything, so they are here; a value set in .env or already in your
# shell wins over the derived one.
#
# XDG_CONFIG_HOME is deliberately NOT overridden. The workshop reads it for
# one thing, the default db.edn, but git, gh, clojure and direnv itself read
# it too, and would lose your config inside this directory. SPECTRE_DB
# isolates the database without that.

# Site settings: this checkout's own db.edn (git-ignored), not your real
# ~/.config/spectre/db.edn. `bb db:seed` and the TUIs write here.
export SPECTRE_DB="${SPECTRE_DB:-$PWD/db.edn}"

# The fixed nREPL port for `gmake nrepl`, `gmake e5-tui` and M-x spectre-nrepl.
# The main checkout keeps the workshop's 1667; a worktree (where .git is a
# file) gets a stable port in 1700-1999 from its directory name, so two
# checkouts can each run `bb dev` at once.
if [ -z "${NREPL_PORT:-}" ]; then
  if [ -f .git ]; then
    NREPL_PORT=$((1700 + $(basename "$PWD" | cksum | cut -d' ' -f1) % 300))
  else
    NREPL_PORT=1667
  fi
fi
export NREPL_PORT

# E6: `bbin install .` puts the pw launcher in this checkout's .bin (ignored),
# first on PATH here. Each worktree then runs its own branch's pw, and your
# ~/.local/bin is left alone.
export BABASHKA_BBIN_BIN_DIR="${BABASHKA_BBIN_BIN_DIR:-$PWD/.bin}"
PATH_add .bin
